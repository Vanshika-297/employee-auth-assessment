# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/employee_auth?retryWrites=true&w=majority

# JWT Authentication Secret and Expiry
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=1d

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
